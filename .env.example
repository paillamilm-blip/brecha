# Proveedor de analisis: "fixture" (sin IA, datos de muestra) o "gemini" (IA real)
ANALISIS_PROVEEDOR=fixture

# Para conectar la IA real solo hacen falta estas dos lineas:
# ANALISIS_PROVEEDOR=gemini
# GEMINI_API_KEY=pega_aqui_tu_clave

# Nombre del modelo. Cambialo si Google renombra los modelos.
GEMINI_MODELO=gemini-2.5-flash

# Tope de analisis por dia, para no quemar la cuota gratuita de un golpe.
ANALISIS_TOPE_DIARIO=10
